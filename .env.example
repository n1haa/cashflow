# Backend only. Embedding requests are disabled until explicitly opted in.
OPENROUTER_API_KEY=put_your_api_key_here
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free
# Optional separate text-generation model slug from OpenRouter; embeddings do not generate chat answers.
OPENROUTER_CHAT_MODEL=
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_SITE_NAME=CashFlow AI
# Set true only after reviewing the OpenRouter/NVIDIA data handling terms for your bank data.
OPENROUTER_ALLOW_FINANCIAL_DATA=false
